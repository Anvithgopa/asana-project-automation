# ==============================================================================
# Asana Project Management Automation - Environment Configuration Template
# ==============================================================================

# 1. Asana Personal Access Token (PAT)
# Generate from: Asana -> My Settings -> Developer -> Personal Access Tokens
ASANA_ACCESS_TOKEN=your_asana_personal_access_token_here

# 2. Asana Workspace GID
# Found in Asana workspace URL: https://app.asana.com/0/<workspace_gid>/
ASANA_WORKSPACE_GID=your_workspace_gid_here

# 3. Target Project GID (Optional for single-project runs)
ASANA_PROJECT_GID=your_project_gid_here

# 4. Storage & Logging Directories (relative or absolute)
DATA_DIR=./data
LOG_DIR=./logs
